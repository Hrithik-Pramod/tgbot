# --- Telegram -----------------------------------------------------------
# Three bots from @BotFather.
BRIDGE_BOT_TOKEN=
SUPPLIER_BOT_TOKEN=
CLIENT_BOT_TOKEN=

# The group/channel that receives deposit notifications, summaries and alerts.
BRIDGE_CHANNEL_ID=

# Optional. Only used when STRICT_BRIDGE_USER is on.
BRIDGE_USER_ID=

# Authorisation is by chat membership: whoever you add to a registered group
# can use that bot as that party. Set to true to additionally require that
# Bridge commands come from BRIDGE_USER_ID.
STRICT_BRIDGE_USER=false

# --- Database -----------------------------------------------------------
# Docker: set the password below. DATABASE_URL is built for you by
# docker-compose.yml and does not need setting here.
POSTGRES_DB=settlement
POSTGRES_USER=settlement
POSTGRES_PASSWORD=

# Without Docker only: point this at your own PostgreSQL.
# DATABASE_URL=postgresql://settlement:CHANGE_ME@localhost:5432/settlement

# --- TRON ---------------------------------------------------------------
TRONGRID_API_KEY=
POLL_INTERVAL_SECONDS=20

# TESTING ONLY. Set to TRX to monitor native TRX instead of TRC20 USDT, so a
# real end-to-end test costs a fraction of a TRX rather than the 13-27 TRX of
# energy a USDT transfer burns. MUST be USDT in production — the bot logs a
# warning on every start while this is set to TRX.
MONITOR_ASSET=USDT

# --- Behaviour ----------------------------------------------------------
RATE_STALENESS_HOURS=24

# --- Container ----------------------------------------------------------
# Log timestamps render in this timezone. Europe/London or Asia/Kolkata.
TZ=UTC

# Pasted payments are recorded straight away and acknowledged with a thumbs up
# (client decision, 8 Sep 2026). Set true to require a Confirm tap instead.
# An unrecognised account name always stops and asks, either way.
REQUIRE_PASTE_CONFIRMATION=false

# Tell the supplier to prepare the next batch once outstanding INR on a trade
# falls to this or below (client request, 8 Sep 2026). Fires once per trade.
NEAR_COMPLETION_INR=300000
